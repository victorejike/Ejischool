{
  "name": "ejischool",
  "private": true,
  "version": "0.1.0",
  "description": "W3Schools-style software learning platform with a Go-first enterprise backend.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ejischool/web",
    "build": "npm run build --workspace @ejischool/web",
    "lint": "npm run lint --workspace @ejischool/web",
    "typecheck": "npm run typecheck --workspace @ejischool/web",
    "api:dev": "go run ./services/api/cmd/server",
    "api:test": "cd services/api && go test ./..."
  },
  "overrides": {
    "csstype": "3.1.3",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "engines": {
    "node": ">=18.19.0",
    "npm": ">=9.0.0",
    "go": ">=1.22"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "1.10.4",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "ajv": "6.12.6",
    "browserslist": "4.28.2",
    "caniuse-lite": "1.0.30001760",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-react": "7.34.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
