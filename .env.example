APP_ENV=production
HTTP_ADDR=:8080
NEXT_PUBLIC_API_URL=https://api.example.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/ejischool?sslmode=require
JWT_ISSUER=ejischool-api
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_SIGNUP_CODE=replace-with-a-private-admin-invite-code
ALLOWED_ORIGINS=https://example.com,https://www.example.com
